<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".SpotAtlasApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SpotAtlas"
        android:windowSoftInputMode="adjustResize">

        <!-- Injected from local.properties / MAPS_API_KEY; empty renders a blank map. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Custom scheme used by AppFunction results: spotatlas://park/<spotId>?plate=..&duration=..
              Always resolves to this app, which is what makes the "open from the Gemini answer"
              step work without any domain setup.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="spotatlas" />
            </intent-filter>

            <!--
              Equivalent https form. autoVerify stays off because the demo does not serve
              /.well-known/assetlinks.json on spotatlas.example.com; turn it on once a real domain
              hosts the Digital Asset Links file and these become verified App Links.
            -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="spotatlas.example.com"
                    android:scheme="https" />
            </intent-filter>
        </activity>

        <!--
          Generated by the AppFunctions KSP compiler from BaseSpotAtlasAppFunctionService. The system
          binds to it to enumerate and run SpotAtlas's functions; BIND_APP_FUNCTION_SERVICE makes sure
          only the platform can.
        -->
        <service
            android:name=".ai.SpotAtlasAppFunctionService"
            android:exported="true"
            android:permission="android.permission.BIND_APP_FUNCTION_SERVICE"
            tools:targetApi="36">
            <property
                android:name="android.app.appfunctions.schema"
                android:value="app_functions_schema.xsd" />
            <property
                android:name="android.app.appfunctions.v2"
                android:value="spotatlas_app_function_service.xml" />
            <intent-filter>
                <action android:name="android.app.appfunctions.AppFunctionService" />
            </intent-filter>
        </service>

        <!-- App-level instructions the agent reads before choosing a function. -->
        <property
            android:name="android.app.appfunctions.app_metadata"
            android:resource="@xml/app_metadata" />
    </application>

</manifest>
